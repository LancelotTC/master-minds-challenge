# Google Cloud (GDELT)

# Project id to use
PROJECT_ID=your_google_project_id
# You can replace the project id with either :
#   Your own project id (personnal)
#   The project id of the airport
# This key is used to pull data from the GDELT data.

# Will be used only once
GDELT_COLD_START_DATE=20221001

RISK_3_COOLDOWN=30
RISK_2_COOLDOWN=14
RISK_1_COOLDOWN=2

# API
API_AIRPORTS=https://api.github.com/repos/davidmegginson/ourairports-data/commits/main
API_MYSOCIETY=https://api.github.com/repos/mysociety/gaze/commits/master

# DATA FOLDERS
DATA_AIRPORTS=https://davidmegginson.github.io/ourairports-data/airports.csv
DATA_MYSOCIETY=https://raw.githubusercontent.com/mysociety/gaze/master/data/fips-10-4-to-iso-country-codes.csv
CAMEO_EVENT=https://www.gdeltproject.org/data/lookups/CAMEO.eventcodes.txt
CAMEO_GOLDSTEIN=https://www.gdeltproject.org/data/lookups/CAMEO.goldsteinscale.txt

TXT_CAMEO_EVENT=data/world_events/CAMEO.eventcodes.txt
TXT_CAMEO_GOLDSTEIN=data/world_events/CAMEO.goldsteinscale.txt

# CONFIG FILES
TRACK_AIRPORTS=config/.last_ourairports_commit.txt
TRACK_MYSOCIETY=config/.last_gaze_fips_commit.txt
TRACK_COUNTRYINFO=config/.last_country_info_date.txt
TRACK_GDELT=config/.last_gdelt_event.txt

# SAVE FILES
CSV_AIRPORTS=data/world_events/airports.csv
CSV_MYSOCIETY=data/world_events/fips-10-4-to-iso-country-codes.csv

PQT_GDELT=data/world_events/gdelt_events/
PQT_AIRPORTS=data/world_events/clean_airports.parquet
PQT_MYSOCIETY=data/world_events/fips-10-4-to-iso-country-codes.parquet
PQT_CLEAN_FIPS=data/world_events/clean_fips_to_iso.parquet
PQT_CLEAN_AIRPORTS=data/world_events/clean_airports.parquet
PQT_COUNTRYINFO=data/world_events/country_info.parquet
PQT_DAILY_RISK=data/world_events/daily_max_risk_events.parquet
TEMP_PQT_DAILY_RISK=data/world_events/temp_daily_max_risk_events.parquet
PQT_CAMEO_MAP=data/world_events/cameo_risk_mapping_clean.parquet
PQT_SMOOTHED_RISK=data/world_events/smoothed_risk_events.parquet

PQT_CAMEO_COUNTRY=data/world_events/CAMEO.country.parquet
PQT_CAMEO_GROUPS=data/world_events/CAMEO.knowngroup.parquet
PQT_CAMEO_TYPES=data/world_events/CAMEO.type.parquet

# LOG PATHS

LOG_DIR=logs
LOG_DL_CONFLICT=download_conflicts.txt
LOG_DL_AIRPORTS=download_airports.txt
LOG_DL_COUNTRYINFO=download_country_info.txt
LOG_TF_EVENTS_ISO=transform_events_iso.txt
LOG_CONFLICT_PIPELINE=pipeline_conflicts.txt