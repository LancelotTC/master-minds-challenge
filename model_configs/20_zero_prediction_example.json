{
  "enabled": true,
  "description": "Example only. Set enabled to true to force NbPaxTotalPrediction to 0 for selected cases.",
  "prediction_overrides": [
    {
      "name": "cap_prediction_to_seats",
      "clip_upper_column": "NbOfSeats"
    },
    {
      "name": "force_zero_pax_when_zero_seats",
      "set_prediction": 0,
      "when": {
        "column": "NbOfSeats",
        "operator": "eq",
        "value": 0
      }
    },
    {
      "name": "force_zero_when_null_idMovement",
      "set_prediction": 0,
      "when": {
        "column": "IdMovement",
        "operator": "is_null"
      }
    },
    {
      "name": "force_zero_when_null_IdADL",
      "set_prediction": 0,
      "when": {
        "column": "IdADL",
        "operator": "is_null"
      }
    }
  ]
}