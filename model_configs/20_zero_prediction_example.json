{
  "enabled": true,
  "description": "Example only. Set enabled to true to force NbPaxTotalPrediction to 0 for selected cases.",
  "prediction_overrides": [
    {
      "name": "force_zero_pax_when_zero_seats",
      "set_prediction": 0,
      "when": {
        "column": "NbOfSeats",
        "operator": "eq",
        "value": 0
      }
    },
    {
      "name": "force_zero_pax_when_business_unit_type_is_not_1",
      "set_prediction": 0,
      "when": {
        "column": "IdBusinessUnitType",
        "operator": "ne",
        "value": 1
      }
    },
    {
      "name": "force_zero_pax_when_cancellation_info_is_given",
      "set_prediction": 0,
      "when": {
        "column": "LTCancellationDatetime",
        "operator": "not_null"
      }
    }
  ]
}